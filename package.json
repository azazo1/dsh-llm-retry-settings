{
  "name": "dsh-llm-retry-settings",
  "version": "0.2.0",
  "description": "DSH plugin: LLM retry settings for 0.1.2-rc.1. Tune retries/backoff/codes; auto-continue truncated or transient failed turns.",
  "keywords": ["dsh", "dsh-plugin", "llm", "retry", "auto-retry", "auto-continue", "max-tokens", "settings", "deepseek"],
  "type": "module",
  "main": "lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["index.js", "lib", "cordis.patch.yml"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azazo1/dsh-llm-retry-settings.git"
  },
  "homepage": "https://github.com/azazo1/dsh-llm-retry-settings",
  "bugs": {
    "url": "https://github.com/azazo1/dsh-llm-retry-settings/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.1.2-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
